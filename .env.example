# Server-side only. Never prefix these with VITE_.
# Primary document reasoning provider.
GROQ_API_KEY=
# Optional comma-separated model order for reasoning failover.
GROQ_REASONING_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Optional reasoning effort for Groq gpt-oss models: low, medium, or high. Default low.
GROQ_REASONING_EFFORT=low
# Separate Groq browser-search model order. Search is only invoked by legal verification.
GROQ_SEARCH_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b

# Provider-wide reasoning fallback. Pinned free model; no automatic free-model roulette.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
# Optional OpenRouter application metadata.
OPENROUTER_SITE_URL=

# Gemini is reserved for OCR of scanned/image-only PDF pages.
GEMINI_API_KEY=
GEMINI_OCR_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.8-flash

# Local OCR fallback language (Tesseract language code).
TESSERACT_LANG=eng
